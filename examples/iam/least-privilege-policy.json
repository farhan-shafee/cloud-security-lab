{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAppLogBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::portfolio-lab-app-logs",
        "arn:aws:s3:::portfolio-lab-app-logs/app/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    }
  ]
}
