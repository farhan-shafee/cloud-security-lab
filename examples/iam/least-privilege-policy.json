{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAppBucketPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::portfolio-lab-app-logs",
        "arn:aws:s3:::portfolio-lab-app-logs/app/*"
      ]
    }
  ]
}
