{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AppBucketFullAccess",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::portfolio-lab-app-logs",
        "arn:aws:s3:::portfolio-lab-app-logs/*"
      ]
    },
    {
      "Sid": "PassAnyRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "*"
    }
  ]
}
